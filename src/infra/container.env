# Runtime settings shared by the local Docker stack (compose.yaml), the Fargate worker
# (cdk/lib/worker-stack.ts), and the Vercel API function (deploy-frontend.sh copies them).
# Keep environment-specific values (bucket, table, endpoints, origins) and provider keys out.
LEGOLIZER_BACKEND=aws
# One generation at a time; extra jobs wait in the shared queue.
LEGOLIZER_WORKERS=1
LEGOLIZER_MAX_PENDING=4
LEGOLIZER_STALE_SECONDS=300
LEGOLIZER_POLL_SECONDS=3
# Offline shape-program jobs (no provider calls); used by the smoke test.
LEGOLIZER_PROGRAM_JOBS=1
# Optional provider/model overrides, applied identically in both environments:
# IMAGE_PROVIDER=openai
# SCENE_PROVIDER=anthropic
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_SCENE_MODEL=gpt-5
# CLAUDE_MODEL=claude-sonnet-4-6
