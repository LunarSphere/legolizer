{
  "openapi": "3.1.0",
  "info": {
    "title": "Legolizer API",
    "version": "1.4.0",
    "description": "Persistent LEGO generation API. Ready builds and jobs survive browser refreshes and server restarts. Provider keys stay on the backend. The local backend runs jobs in-process. The aws backend (LEGOLIZER_BACKEND=aws) keeps jobs in DynamoDB and assets in S3: the API can run anywhere (a Vercel function in the deployed demo) and a single on-demand worker container claims queued jobs, starting when work arrives and stopping when idle. Pending jobs are capped (LEGOLIZER_MAX_PENDING, default 3). Interrupted jobs are marked failed instead of replaying paid calls. Browsers may call it from loopback origins, the Vercel deployment's own origin, or those listed in LEGOLIZER_ALLOWED_ORIGINS; there is no user authentication."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000/api/v1",
      "description": "Local Python backend"
    },
    {
      "url": "/api/v1",
      "description": "Deployed studio on Vercel (same origin; api/index.py)"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness and generation readiness",
        "description": "Served to any host or origin. renderersReady covers LDView, LPub3D and the LDraw library on this host; setupProblem is null when this host can run text jobs. With the aws backend, jobs run on the worker, which checks its own setup and fails a job with code setup_required when something is missing.",
        "responses": {
          "200": {
            "description": "Server status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "backend": {
                      "type": "string",
                      "enum": [
                        "local",
                        "aws"
                      ]
                    },
                    "renderersReady": {
                      "type": "boolean"
                    },
                    "setupProblem": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "backend",
                    "renderersReady",
                    "setupProblem"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sizing": {
      "post": {
        "operationId": "estimateSize",
        "summary": "Suggest a build size for a description or image",
        "description": "Asks the design provider's small model for a longest-side target in studs (16-32 in steps of 4) and a short reason. Does not start a build.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SizeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Suggested size",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SizeEstimate"
                }
              }
            }
          },
          "400": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "The size estimate call failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/builds": {
      "get": {
        "operationId": "listBuilds",
        "summary": "List completed builds",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Opaque nextCursor from the previous page."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of ready builds",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Build"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createBuild",
        "summary": "Queue a new saved LEGO set",
        "description": "Returns immediately. Only succeeded jobs include a ready buildId. Idempotency keys deduplicate retries for the lifetime of the saved job; different bodies using the same key return 409. Failed generations preserve earlier builds. The current pipeline uses its fixed eight-color palette. Accepts text or one base64-encoded image in JSON. Image jobs skip OpenAI view generation and pass the validated image directly to Claude. Requests are capped at 6 MiB (4.5 MB on Vercel). Saved source images are not publicly served. Image jobs require only the Anthropic provider key. Shape-program jobs (program) run offline without provider keys and return 403 program_disabled unless the server sets LEGOLIZER_PROGRAM_JOBS=1. 429 means the pending-job cap is reached.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBuild"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/builds/{buildId}": {
      "parameters": [
        {
          "name": "buildId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      ],
      "get": {
        "operationId": "getBuild",
        "summary": "Get a completed build and asset URLs",
        "responses": {
          "200": {
            "description": "Ready build",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Build"
                }
              }
            }
          },
          "404": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/builds/{buildId}/refinements": {
      "parameters": [
        {
          "name": "buildId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      ],
      "post": {
        "operationId": "refineBuild",
        "summary": "Queue a generative infill of a saved build",
        "description": "Regenerates the selected pieces plus one brick around each from a new prompt, or the whole model when selection is empty, and saves the result as a new build; the original build is unchanged. Pieces entirely outside that zone keep their exact placement, and pieces inside it that the edit leaves as they were are kept when possible; the finished build reports how many were rebuilt. Several candidate edits are designed in parallel and the best is kept. Returns immediately with a job whose inputType is refine. Idempotency works as for createBuild. Requires a design provider key but not OpenAI image generation.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRefinement"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/builds/{buildId}/parts": {
      "parameters": [
        {
          "name": "buildId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      ],
      "get": {
        "operationId": "getParts",
        "summary": "Get quantities and purchase catalog links by part and color",
        "responses": {
          "200": {
            "description": "Color-aware bill of materials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartsList"
                }
              }
            }
          },
          "404": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{jobId}": {
      "parameters": [
        {
          "name": "jobId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      ],
      "get": {
        "operationId": "getJob",
        "summary": "Poll generation status",
        "description": "Poll every 2\u20135 seconds until succeeded or failed. buildId is null until succeeded. error is non-null only for failed jobs. Progress is approximate, from 0 to 1.",
        "responses": {
          "200": {
            "description": "Current job status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "404": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Request failed. No provider credentials or internal traceback are exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "operationId": "listJobs",
        "summary": "List persisted jobs, including completed and failed jobs",
        "responses": {
          "200": {
            "description": "Persisted job history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Job"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/assets/{buildId}/{filename}": {
      "get": {
        "operationId": "getBuildAsset",
        "summary": "Download an artifact belonging to a completed build",
        "parameters": [
          {
            "name": "buildId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "packed.mpd",
                "model.mpd",
                "LDConfig.ldr",
                "build-guide.pdf",
                "parts.json",
                "render.png",
                "readme.txt",
                "careadme.txt",
                "calicense.txt",
                "calicense4.txt"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Artifact bytes; Content-Type matches file format (local backend)"
          },
          "302": {
            "description": "Redirect to a short-lived S3 URL (aws backend)",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or unpublished artifact"
          }
        },
        "description": "The local backend returns the bytes. The aws backend responds 302 with a presigned S3 URL valid for 15 minutes; MPD, LDraw, and JSON files download as attachments."
      }
    }
  },
  "components": {
    "schemas": {
      "Assets": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "format": "uri-reference",
            "description": "HTTP(S) URL or root-relative URL. Relative URLs resolve against the API origin. Cross-origin resources must allow CORS. Self-contained MPD with all referenced official geometry embedded under FILE records; preserves original part licensing. No external part fetches required."
          },
          "ldraw": {
            "type": "string",
            "format": "uri-reference",
            "description": "Original editable MPD at an HTTP(S) or root-relative URL. Same-origin browser download link supplies the filename."
          },
          "colors": {
            "type": "string",
            "format": "uri-reference",
            "description": "HTTP(S) URL or root-relative URL. Relative URLs resolve against the API origin. Cross-origin resources must allow CORS. Official LDConfig.ldr material definitions (text/plain)."
          },
          "instructions": {
            "type": "string",
            "format": "uri-reference",
            "description": "HTTP(S) URL or root-relative URL. Relative URLs resolve against the API origin. Cross-origin resources must allow CORS. LPub3D PDF guide (application/pdf)."
          },
          "parts": {
            "type": "string",
            "format": "uri-reference",
            "description": "HTTP(S) URL or root-relative URL. Relative URLs resolve against the API origin. Cross-origin resources must allow CORS. Downloadable JSON conforming to PartsList."
          },
          "preview": {
            "type": "string",
            "format": "uri-reference",
            "description": "HTTP(S) URL or root-relative URL. Relative URLs resolve against the API origin. Cross-origin resources must allow CORS. PNG render used as a WebGL fallback."
          }
        },
        "required": [
          "model",
          "ldraw",
          "colors",
          "instructions",
          "parts",
          "preview"
        ]
      },
      "Build": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          },
          "partCount": {
            "type": "integer",
            "minimum": 0
          },
          "colorCount": {
            "type": "integer",
            "minimum": 0
          },
          "stepCount": {
            "type": "integer",
            "minimum": 0
          },
          "assets": {
            "$ref": "#/components/schemas/Assets"
          },
          "refinement": {
            "$ref": "#/components/schemas/Refinement"
          },
          "size": {
            "$ref": "#/components/schemas/SizeEstimate"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "status",
          "partCount",
          "colorCount",
          "stepCount",
          "assets"
        ]
      },
      "Region": {
        "type": "object",
        "additionalProperties": false,
        "description": "Inclusive grid cells. x and y are studs (0\u201319); z is plates above the ground (0\u201359, three plates per brick). min must not exceed max on any axis.",
        "properties": {
          "min": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 3,
            "maxItems": 3
          },
          "max": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "min",
          "max"
        ]
      },
      "CreateRefinement": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S",
            "description": "The change to make."
          },
          "selection": {
            "type": "array",
            "maxItems": 400,
            "items": {
              "$ref": "#/components/schemas/Region"
            },
            "default": [],
            "description": "Cells of the selected pieces, one box per piece. Only these cells and a margin of one brick around each (one stud sideways, three plates up and down) may change. Empty or omitted lets the edit touch the whole model."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Name for the new build. Defaults to the original name with (refined)."
          }
        },
        "required": [
          "prompt"
        ]
      },
      "Refinement": {
        "type": "object",
        "additionalProperties": false,
        "description": "Present on builds produced by refineBuild.",
        "properties": {
          "parentId": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "selection": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Region"
            },
            "description": "The selected pieces the edit was limited to; empty for a whole-model edit."
          },
          "keptPieces": {
            "type": "integer",
            "minimum": 0,
            "description": "Original pieces that kept their exact placement. Pieces entirely outside the editable zone always do."
          },
          "rebuiltPieces": {
            "type": "integer",
            "minimum": 0,
            "description": "Original pieces inside the editable zone that were removed or rebuilt."
          }
        },
        "required": [
          "parentId",
          "prompt",
          "selection",
          "keptPieces",
          "rebuiltPieces"
        ]
      },
      "Part": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "part_id": {
            "type": "string"
          },
          "color_id": {
            "type": "integer",
            "minimum": 0
          },
          "color": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "bricklink_url": {
            "type": "string",
            "format": "uri-reference",
            "description": "HTTP(S) URL or root-relative URL. Relative URLs resolve against the API origin. Cross-origin resources must allow CORS."
          }
        },
        "required": [
          "part_id",
          "color_id",
          "color",
          "quantity",
          "bricklink_url"
        ]
      },
      "PartsList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Part"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "CreateBuild": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "maxColors": {
            "type": "integer",
            "const": 8,
            "default": 8
          },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mediaType",
              "data"
            ],
            "properties": {
              "mediaType": {
                "type": "string",
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "image/webp"
                ]
              },
              "data": {
                "type": "string",
                "contentEncoding": "base64",
                "maxLength": 4194304,
                "description": "Raw base64, without a data URL prefix. Decoded file up to 3 MiB. Still image with dimensions 32\u20134096 pixels per side. File contents must match mediaType."
              }
            }
          },
          "program": {
            "type": "object",
            "description": "Shape program JSON, as in examples/ and tests/fixtures. Cannot be combined with image; description is optional."
          },
          "maxSize": {
            "type": "integer",
            "minimum": 16,
            "maximum": 32,
            "multipleOf": 4,
            "description": "Longest side in studs. Omit to let the design model estimate from the description or image."
          }
        },
        "required": [],
        "anyOf": [
          {
            "required": [
              "image"
            ]
          },
          {
            "required": [
              "program"
            ]
          },
          {
            "required": [
              "description"
            ],
            "properties": {
              "description": {
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        ],
        "description": "Text \u2192 LEGO: required nonblank description, no image. Image \u2192 LEGO: required image, optional description as guidance. Shape program: required program, no image. Optional name in all modes."
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "queued",
              "views",
              "scene",
              "assembly",
              "render",
              "instructions",
              "complete",
              "failed"
            ]
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "buildId": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "inputType": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "program",
              "refine"
            ]
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "description": "For refine jobs, the build being refined. For refine jobs, description holds the refinement prompt."
          }
        },
        "required": [
          "id",
          "status",
          "stage",
          "progress",
          "buildId",
          "error",
          "name",
          "description",
          "inputType",
          "parentId"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "SizeEstimate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "size",
          "reason"
        ],
        "properties": {
          "size": {
            "type": "integer",
            "minimum": 16,
            "maximum": 32,
            "multipleOf": 4
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "SizeRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mediaType",
              "data"
            ],
            "properties": {
              "mediaType": {
                "type": "string",
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "image/webp"
                ]
              },
              "data": {
                "type": "string",
                "contentEncoding": "base64",
                "maxLength": 5592408,
                "description": "Raw base64, without a data URL prefix. Decoded file up to 4 MiB. Still image with dimensions 32\u20134096 pixels per side. File contents must match mediaType."
              }
            }
          }
        },
        "description": "Text and/or an image. At least one is required."
      }
    }
  }
}
