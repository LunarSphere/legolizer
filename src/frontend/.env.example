# Default: same-origin /api/v1. Vite proxies it to the Python server at 127.0.0.1:8000;
# on Vercel it is routed to the api/index.py function (see /vercel.json).
VITE_API_BASE_URL=/api/v1
VITE_BUILD_ID=robot-corrected
# Optional view-only mode; disables generation and reads the bundled robot.
VITE_DEMO=false
# Never put provider API keys in VITE_* variables; they are public browser code.
