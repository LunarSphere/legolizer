# Copy this file to .env and replace the placeholder values.
OPENAI_API_KEY=your-openai-api-key
# Optional: use Claude to read the reference image. Without it, OpenAI does this too.
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional model overrides.
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_SCENE_MODEL=gpt-6-sol
CLAUDE_MODEL=claude-sonnet-4-6
# Design model (shape-program JSON, reviews and edits): openai, anthropic or grok.
# Unset picks Claude, then OpenAI, then Grok, by which key is present.
# SCENE_PROVIDER=openai
# GROK_SCENE_MODEL=grok-4.20-0309-reasoning
# Small models for quick classification calls such as the build-size estimate.
# OPENAI_FAST_MODEL=gpt-5-mini
# GROK_FAST_MODEL=grok-4.20-0309-non-reasoning
# CLAUDE_FAST_MODEL=claude-haiku-4-5
# Candidate edits a refinement requests in parallel (1-6; more costs more API credits).
# LEGOLIZER_INFILL_CANDIDATES=3

# Concept image provider for text builds: openai (default) or grok (xAI Grok Imagine).
# With IMAGE_PROVIDER=grok and SCENE_PROVIDER=grok, GROK_API_KEY is the only key needed.
# IMAGE_PROVIDER=openai
# GROK_API_KEY=your-xai-api-key
# GROK_IMAGE_MODEL=grok-imagine-image

# Optional renderer and LDraw library paths (Windows example; use forward or back slashes).
# LDVIEW_BIN=C:\Program Files\LDView\LDView64.exe
# LPUB3D_BIN=C:\Program Files\LPub3D\LPub3D.exe
# LDRAW_LIBRARY_PATH=C:\Users\you\AppData\Local\pyldraw3\pyldraw3\Cache\complete\ldraw
